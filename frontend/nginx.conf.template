server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    gzip            on;
    gzip_min_length 1024;
    gzip_types      text/css application/javascript application/json image/svg+xml;

    # Vite appose une empreinte au nom des fichiers : ils sont immuables,
    # donc cachables sans limite.
    location /assets/ {
        # Un seul en-tete : `expires` en emettrait un second, redondant.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Routage cote client : toute URL inconnue doit rendre index.html,
    # sinon un rechargement sur /tasks renverrait un 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # L'API est servie sous la meme origine que l'interface : aucun preflight
    # CORS en production, exactement comme le proxy de developpement de Vite.
    location /api/ {
        proxy_pass         ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Origin efface : l'appel est serveur-a-serveur et n'a aucun contexte
        # CORS. Le relayer ferait echouer le controle de Spring Security.
        proxy_set_header   Origin            "";
        proxy_read_timeout 30s;
    }

    # Sonde de disponibilite du backend, utile aux plateformes d'hebergement.
    location = /actuator/health {
        proxy_pass       ${API_URL};
        proxy_set_header Origin "";
        access_log       off;
    }
}
